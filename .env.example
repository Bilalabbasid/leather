# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App URL (Update to your Vercel deployment URL or custom domain in production)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Admin Authentication Secret (Generate a strong 32+ character random string)
ADMIN_AUTH_SECRET="your-super-secret-admin-key"

# Supabase Platform Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_DB_PASSWORD="your-supabase-db-password"
